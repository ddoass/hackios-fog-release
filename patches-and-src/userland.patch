+/*
+ * Diagnostics (boot-arg sb_threads=<seconds>; absent or 0 is off): every <seconds> the stack of every
+ * thread of this process, each address named the way dyld knows it (dladdr: the image's file name, and
+ * its symbol when the image exports one). The stacks the kernel prints (ustacks=) stop at sixteen
+ * frames and know no names, and 3 threads is too little to tell an idle run loop from a wait: this
+ * says what each thread stands in, so the one that keeps the window server from the first frame is
+ * named. The run loop of the main thread is watched from here as well: "woke N ms ago" tells whether
+ * the main thread is alive at all.
+ */
+static mach_port_t sb_main_thread;
+static uint64_t sb_main_woke;           /* us, when the main run loop last woke up; 0: not yet */
+
+static void
+main_woke_note(__unused CFRunLoopObserverRef observer, CFRunLoopActivity activity, __unused void *info)
+{
+	if (activity == kCFRunLoopAfterWaiting) {
+		sb_main_woke = now_us();
+	}
+}
+
+static void
+symbol_of(uint64_t address, char *out, size_t size)
+{
+	Dl_info info;
+
+	if (dladdr((const void *)(uintptr_t)address, &info) != 0 && info.dli_fname != NULL) {
+		const char *slash = strrchr(info.dli_fname, '/');
+		const char *image = slash != NULL ? slash + 1 : info.dli_fname;
+
+		if (info.dli_sname != NULL) {
+			snprintf(out, size, "%s %s+%#lx", image, info.dli_sname,
+			    (unsigned long)(address - (uint64_t)(uintptr_t)info.dli_saddr));
+		} else {
+			snprintf(out, size, "%s+%#lx", image, (unsigned long)(address - (uint64_t)(uintptr_t)info.dli_fbase));
+		}
+	} else {
+		snprintf(out, size, "%#llx", (unsigned long long)address);
+	}
+}
+
+/* One thread's stack, one frame a line: /dev/console cuts a long line and drops it when busy. */
+static void
+say_thread_stack(int index, bool main_thread, uint64_t pc, uint64_t fp)
+{
+	char line[300];
+	char symbol[220];
+	int depth;
+
+	symbol_of(pc, symbol, sizeof(symbol));
+	snprintf(line, sizeof(line), "hakios: t%d%s %s\n", index, main_thread ? "(main)" : "", symbol);
+	write(say_fd, line, strlen(line));
+	for (depth = 1; depth <= 14 && fp != 0; depth++) {
+		uint64_t frame[2] = { 0, 0 };
+		vm_size_t got = 0;
+
+		if ((fp & 7) != 0 || fp < 0x10000) {
+			break;
+		}
+		if (vm_read_overwrite(mach_task_self(), (vm_address_t)fp, sizeof(frame),
+		    (vm_address_t)frame, &got) != KERN_SUCCESS || got != sizeof(frame)) {
+			break;
+		}
+		if (frame[1] < 0x1000) {
+			break;
+		}
+		symbol_of(frame[1], symbol, sizeof(symbol));
+		snprintf(line, sizeof(line), "hakios: t%d#%d %s\n", index, depth, symbol);
+		write(say_fd, line, strlen(line));
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
+
+static void
+say_all_threads(void)
+{
+	thread_act_array_t threads = NULL;
+	mach_msg_type_number_t count = 0;
+	unsigned i;
+
+	if (sb_main_woke != 0) {
+		say("hakios: threads: the main run loop woke %llu ms ago\n", (unsigned long long)((now_us() - sb_main_woke) / 1000));
+	} else {
+		say("hakios: threads: the main run loop has not woken yet\n");
+	}
+	if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS) {
+		say("hakios: threads: task_threads failed\n");
+		return;
+	}
+	say("hakios: threads: %u\n", count);
+	for (i = 0; i < count; i++) {
+		arm_thread_state64_t state;
+		mach_msg_type_number_t size = ARM_THREAD_STATE64_COUNT;
+
+		if (thread_get_state(threads[i], ARM_THREAD_STATE64, (thread_state_t)&state, &size) != KERN_SUCCESS) {
+			continue;
+		}
+		say_thread_stack((int)i, threads[i] == sb_main_thread, arm_thread_state64_get_pc(state),
+		    arm_thread_state64_get_fp(state));
+	}
+	for (i = 0; i < count; i++) {
+		mach_port_deallocate(mach_task_self(), threads[i]);
+	}
+	vm_deallocate(mach_task_self(), (vm_address_t)threads, count * sizeof(thread_t));
+}
+
+static void *
+threads_watchdog(void *argument)
+{
+	unsigned seconds = *(unsigned *)argument;
+
+	free(argument);
+	for (;;) {
+		sleep(seconds);
+		say_all_threads();
+	}
+	return NULL;
+}
+
+static void
+watch_threads(const char *arguments)
+{
+	const char *setting = strstr(arguments, "sb_threads=");
+	CFRunLoopObserverRef observer;
+	pthread_t thread;
+	char *end;
+	double interval;
+	unsigned *seconds, period;
+
+	if (setting == NULL || (setting != arguments && setting[-1] != ' ')) {
+		return;
+	}
+	setting += 11;
+	interval = strtod(setting, &end);
+	if (end == setting || (*end != 0 && *end != ' ') || !(interval > 0 && interval <= UINT_MAX)) {
+		return;
+	}
+	period = interval < 1 ? 1 : (unsigned)interval;
+	if ((seconds = malloc(sizeof(*seconds))) == NULL) {
+		return;
+	}
+	*seconds = period;
+	if (timebase.denom == 0) {
+		mach_timebase_info(&timebase);
+	}
+	sb_main_thread = mach_thread_self();    /* this constructor runs on the main thread */
+	if (pthread_create(&thread, NULL, threads_watchdog, seconds) != 0) {
+		mach_port_deallocate(mach_task_self(), sb_main_thread);
+		sb_main_thread = MACH_PORT_NULL;
+		free(seconds);
+		say("hakios: threads: no watchdog\n");
+		return;
+	}
+	pthread_detach(thread);
+	observer = CFRunLoopObserverCreate(NULL, kCFRunLoopAfterWaiting, true, 0, main_woke_note, NULL);
+	if (observer != NULL) {
+		CFRunLoopAddObserver(CFRunLoopGetMain(), observer, kCFRunLoopCommonModes);
+		CFRelease(observer);
+	}
+	say("hakios: threads: a stack of every thread every %u s\n", period);
+}
