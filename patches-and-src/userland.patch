+/*
+ * An exception that ends the process is said on the console in full here: the runtime prints
+ * "*** Terminating app due to uncaught exception ... reason:" itself, but the console cuts the line
+ * (run 26: "*** -[__NSSetM removeObject:]: object ca"), and what follows -- the stack -- is the part
+ * that says which code of SpringBoard did it.
+ */
+extern void NSSetUncaughtExceptionHandler(void (*handler)(id exception));
+
+/*
+ * The method of this process that a stack address belongs to: the call stacks that come with an
+ * exception name the image and an offset only (the shared cache has no method symbols), and the
+ * class that does a wrong thing is what one needs to see.
+ */
+static bool
+sb_method_at(void *address, char *out, size_t size)
+{
+	int count = objc_getClassList(NULL, 0), i;
+	Class *classes;
+
+	if (count <= 0 || (classes = malloc(sizeof(Class) * (size_t)count)) == NULL) {
+		return false;
+	}
+	count = objc_getClassList(classes, count);
+	for (i = 0; i < count; i++) {
+		int kind;
+
+		for (kind = 0; kind < 2; kind++) {
+			Class cls = kind == 0 ? classes[i] : object_getClass((id)classes[i]);
+			unsigned n = 0, j;
+			Method *methods = class_copyMethodList(cls, &n);
+
+			if (methods == NULL) {
+				continue;
+			}
+			for (j = 0; j < n; j++) {
+				if ((void *)method_getImplementation(methods[j]) == address) {
+					snprintf(out, size, "%c[%s %s]", kind == 0 ? '-' : '+', class_getName(classes[i]),
+					    sel_getName(method_getName(methods[j])));
+					free(methods);
+					free(classes);
+					return true;
+				}
+			}
+			free(methods);
+		}
+	}
+	free(classes);
+	return false;
+}
