+/*
+ * The names of the frames of a stack ("+[NSThread callStackSymbols]", "-[NSException
+ * callStackSymbols]") are looked up by dyld, walking every image of the shared cache, which here is
+ * gigabytes on the phone's flash: in run 31 SpringBoard's main thread was found in the middle of
+ * that lookup in most dumps of its launch, always reached from Foundation formatting a %@ in some
+ * log line. A stack in a log is worth nothing next to the screen, so these two answer with one
+ * frame and the lookup is not made. (The method is hooked and not the library function: the call
+ * comes from the shared cache, whose references the interposing table does not reach.)
+ */
+static id
+sb_no_stack_symbols(__unused id self, __unused SEL selector)
+{
+	static id names;
+
+	if (names == NULL) {
+		id text = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass("NSString"), sel_registerName("alloc"));
+
+		text = ((id (*)(id, SEL, const char *))objc_msgSend)(text, sel_registerName("initWithUTF8String:"),
+		    "(no symbols)");
+		names = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass("NSArray"), sel_registerName("alloc"));
+		names = ((id (*)(id, SEL, id *, unsigned long))objc_msgSend)(names, sel_registerName("initWithObjects:count:"),
+		    &text, 1);
+	}
+	return names;
+}
