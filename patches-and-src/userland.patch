+
+static void
+sb_remove_object(id self, SEL selector, id object)
+{
+	if (object == NULL) {
+		/* Taking nil out of a set is a no-op by intent; __NSSetM only refuses to be asked. SpringBoard
+		   does ask (run 27, at its own +0x260ab4) and ends on it, so the question is not put to it. */
+		say("hakios: removeObject:nil ignored on %s\n", class_getName(object_getClass(self)));
+		return;
+	}
+	original_remove_object(self, selector, object);
+}
