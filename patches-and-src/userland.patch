+/*
+ * Diagnostics: the name of the service a blocking XPC call waits for. SpringBoard's main thread stood
+ * in mach_msg2_trap under ControlCenterServices->BaseBoard (ustacks, run 22) while the screen stayed on
+ * the boot logo, and a Mach request with a reply is the shape of that wait: every synchronous send says
+ * on the console (applog=1) which service it asks and when the answer came, so the one without an answer
+ * is the service the launch hangs on. The SDK here has no xpc.h, and the two functions are looked up in
+ * libxpc at load time.
+ */
+typedef struct _xpc_connection_s *hakios_xpc_connection;
+typedef struct _xpc_object_s *hakios_xpc_object;
+extern const char *xpc_connection_get_name(hakios_xpc_connection);
+extern hakios_xpc_object xpc_connection_send_message_with_reply_sync(hakios_xpc_connection, hakios_xpc_object);
+
+extern hakios_xpc_object xpc_dictionary_create(const hakios_xpc_object *keys, const hakios_xpc_object *values,
+    size_t count);
+
+/*
+ * An endpoint is what an NSXPCConnection to another process is made from; its description says which
+ * service it is for (an anonymous connection -- the one that never answers, run 25 -- is one made from
+ * an endpoint, so the name is here and not on the connection).
+ */
+extern hakios_xpc_object xpc_endpoint_create(hakios_xpc_connection connection);
+
+static hakios_xpc_object
+hakios_xpc_endpoint_create(hakios_xpc_connection connection)
+{
+	const char *service = connection != NULL ? xpc_connection_get_name(connection) : NULL;
+	hakios_xpc_object endpoint = xpc_endpoint_create(connection);
+
+	say("hakios: endpoint for %s\n", service != NULL ? service : "(none)");
+	return endpoint;
+}
+
+/*
+ * An anonymous connection is one made from an endpoint another process handed over, and a call on it
+ * is a call to that process. In run 25 one such call never returned and held a lock of CoreServices
+ * that SpringBoard's main thread waited for, so the launch stood still; an empty reply was returned
+ * instead and the launch went on -- but 510 of these calls in one run (run 31) all got that empty
+ * reply, and whatever SpringBoard asked of those processes it did not get.
+ *
+ * So the call is made here, on a thread of its own, and waited for only so long: a real reply is
+ * handed back as it is (the peers do answer, if they are alive), and only when one does not come in
+ * ANONYMOUS_MS is the empty reply returned to let the lock go. The peer's process and the code that
+ * asked are said, so a peer that never answers can be found.
+ */
+/*
+ * A live daemon on this phone answers in tens of seconds under the software render (backboardd's
+ * display call took twenty-nine and seventy-nine in run 34), and a daemon that is alive but has
+ * no answer for the call does not answer at all: chronod held the launch's main thread for the
+ * full two minutes of run 34 for nothing. So the process behind the connection is asked for its
+ * name, and only the window server and lsd are waited for as long as that; everything else gets
+ * two seconds (a service that is not even resolved yet gets that too -- launchd and the like
+ * answer in milliseconds).
+ */
+#define PEER_MS_LIVE    90000
+#define PEER_MS_FAST    2000
+
+static const char *
+peer_name(int pid, char *name, size_t size)
+{
+	struct kinfo_proc info;
+	int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, pid };
+	size_t length = sizeof(info);
+
+	memset(&info, 0, sizeof(info));
+	if (sysctl(mib, 4, &info, &length, NULL, 0) != 0 || length == 0 || info.kp_proc.p_comm[0] == 0) {
+		return NULL;
+	}
+	strlcpy(name, info.kp_proc.p_comm, size);
+	return name;
+}
+
+static unsigned
+peer_wait_for(int pid, char *name, size_t size, const char **named)
+{
+	const char *peer = pid > 0 ? peer_name(pid, name, size) : NULL;
+
+	*named = peer;
+	if (peer != NULL && (strcmp(peer, "backboardd") == 0 || strcmp(peer, "lsd") == 0 ||
+	    strcmp(peer, "SpringBoard") == 0)) {
+		return PEER_MS_LIVE;
+	}
+	return PEER_MS_FAST;
+}
+
+extern pid_t xpc_connection_get_pid(hakios_xpc_connection);
+extern hakios_xpc_object xpc_retain(hakios_xpc_object);
+extern void xpc_release(hakios_xpc_object);
+
+struct hakios_call {
+	hakios_xpc_connection connection;
+	hakios_xpc_object message;
+	hakios_xpc_object reply;
+	bool done, dropped;
+	pthread_mutex_t lock;
+	pthread_cond_t wake;
+	struct hakios_call *next;
+};
+
+static pthread_mutex_t calls_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t calls_wake = PTHREAD_COND_INITIALIZER;
+static struct hakios_call *calls_first, *calls_last;
+static pthread_once_t calls_once = PTHREAD_ONCE_INIT;
+
+static void *
+hakios_calls_worker(__unused void *ignored)
+{
+	for (;;) {
+		struct hakios_call *call;
+		hakios_xpc_object reply;
+
+		pthread_mutex_lock(&calls_lock);
+		while (calls_first == NULL) {
+			pthread_cond_wait(&calls_wake, &calls_lock);
+		}
+		call = calls_first;
+		calls_first = call->next;
+		if (calls_first == NULL) {
+			calls_last = NULL;
+		}
+		pthread_mutex_unlock(&calls_lock);
+
+		reply = xpc_connection_send_message_with_reply_sync(call->connection, call->message);
+		xpc_release(call->message);
+		xpc_release((hakios_xpc_object)call->connection);
+		pthread_mutex_lock(&call->lock);
+		if (call->dropped) {
+			pthread_mutex_unlock(&call->lock);
+			if (reply != NULL) {
+				xpc_release(reply);
+			}
+			pthread_cond_destroy(&call->wake);
+			pthread_mutex_destroy(&call->lock);
+			free(call);
+			continue;
+		}
+		call->reply = reply;
+		call->done = true;
+		pthread_cond_signal(&call->wake);
+		pthread_mutex_unlock(&call->lock);
+	}
+	return NULL;
+}
+
+static void
+hakios_calls_start(void)
+{
+	/*
+	 * Four of them: one slow call (the display's own takes up to eighty seconds) must not hold
+	 * the others behind it -- in run 35 a single worker made every caller wait for the mapdb
+	 * calls that never ended.
+	 */
+	for (unsigned i = 0; i < 4; i++) {
+		pthread_t thread;
+
+		if (pthread_create(&thread, NULL, hakios_calls_worker, NULL) == 0) {
+			pthread_detach(thread);
+		}
+	}
+}
+
+/* the reply if it comes within ms, otherwise NULL (the call goes on without us) */
+static hakios_xpc_object
+hakios_call_within(hakios_xpc_connection connection, hakios_xpc_object message, unsigned ms)
+{
+	struct hakios_call *call;
+	struct timespec until;
+	hakios_xpc_object reply = NULL;
+
+	pthread_once(&calls_once, hakios_calls_start);
+	if ((call = calloc(1, sizeof(*call))) == NULL) {
+		return NULL;
+	}
+	pthread_mutex_init(&call->lock, NULL);
+	pthread_cond_init(&call->wake, NULL);
+	call->connection = (hakios_xpc_connection)xpc_retain((hakios_xpc_object)connection);
+	call->message = xpc_retain(message);
+
+	pthread_mutex_lock(&calls_lock);
+	if (calls_last != NULL) {
+		calls_last->next = call;
+	} else {
+		calls_first = call;
+	}
+	calls_last = call;
+	pthread_cond_signal(&calls_wake);
+	pthread_mutex_unlock(&calls_lock);
+
+	clock_gettime(CLOCK_REALTIME, &until);
+	until.tv_sec += ms / 1000;
+	until.tv_nsec += (long)(ms % 1000) * 1000000L;
+	if (until.tv_nsec >= 1000000000L) {
+		until.tv_sec++;
+		until.tv_nsec -= 1000000000L;
+	}
+	pthread_mutex_lock(&call->lock);
+	while (!call->done) {
+		if (pthread_cond_timedwait(&call->wake, &call->lock, &until) != 0) {
+			break;
+		}
+	}
+	if (call->done) {
+		reply = call->reply;
+		pthread_mutex_unlock(&call->lock);
+		pthread_cond_destroy(&call->wake);
+		pthread_mutex_destroy(&call->lock);
+		free(call);
+	} else {
+		call->dropped = true;
+		pthread_mutex_unlock(&call->lock);
+	}
+	return reply;
+}
+
+static void
+hakios_where(void *address, char *out, size_t size)
+{
+	Dl_info info;
+
+	if (address == NULL || dladdr(address, &info) == 0 || info.dli_fname == NULL) {
+		snprintf(out, size, "?");
+		return;
+	}
+	snprintf(out, size, "%s+%#lx", strrchr(info.dli_fname, '/') != NULL ? strrchr(info.dli_fname, '/') + 1 : info.dli_fname,
+	    (unsigned long)((uintptr_t)address - (uintptr_t)info.dli_fbase));
+}
+
+static hakios_xpc_object
+hakios_xpc_send_sync(hakios_xpc_connection connection, hakios_xpc_object message)
+{
+	const char *service = connection ? xpc_connection_get_name(connection) : NULL;
+	hakios_xpc_object reply;
+	int pid = connection ? (int)xpc_connection_get_pid(connection) : 0;
+	const char *named = NULL;
+	char peer[24];
+	unsigned wait_ms;
+	static unsigned asked, answered, lost;
+	void *caller0 = __builtin_return_address(0), *caller1 = __builtin_return_address(1);
+	char where[160];
+
+	if (connection == NULL || (service == NULL && pid <= 0)) {
+		/* no peer is named, so no reply can come: the empty one at once, without a wait at all */
+		return xpc_dictionary_create(NULL, NULL, 0);
+	}
+	asked++;
+	hakios_where(caller0, where, sizeof(where));
+	wait_ms = peer_wait_for(pid, peer, sizeof(peer), &named);
+	/*
+	 * LaunchServices' mapdb calls do not answer at all (lsd is alive but never replies: run 35
+	 * waited five times for ninety seconds on its own main thread and the launch stood still for
+	 * seven and a half minutes), and the launch does not need them to come to the lock screen.
+	 */
+	if ((service != NULL && strstr(service, ".mapdb") != NULL) ||
+	    strstr(where, "Foundation+0x99314") != NULL) {
+		wait_ms = PEER_MS_FAST;
+	}
+	if (asked <= 8) {
+		say("hakios: xpc %s pid %d (%s): %u ms\n", service != NULL ? service : "(none)", pid,
+		    named != NULL ? named : "unresolved", wait_ms);
+	}
+	reply = hakios_call_within(connection, message, wait_ms);
+	if (reply != NULL) {
+		answered++;
+		if (answered <= 12) {
+			say("hakios: xpc %s pid %d (%s) answered (%s)\n", service != NULL ? service : "(none)",
+			    pid, named != NULL ? named : "unresolved", where);
+		}
+		return reply;
+	}
+	lost++;
+	if (lost <= 10) {
+		char up[160];
+
+		hakios_where(caller1, up, sizeof(up));
+		say("hakios: xpc %s pid %d (%s): nothing in %u ms (%s <- %s)\n",
+		    service != NULL ? service : "(none)", pid, named != NULL ? named : "unresolved", wait_ms,
+		    where, up);
+	} else if (asked % 100 == 0) {
+		say("hakios: xpc: %u asked, %u answered, %u empty\n", asked, answered, lost);
+	}
+	return xpc_dictionary_create(NULL, NULL, 0);
+}
+
+/*
+ * Every name SpringBoard looks up in its bootstrap namespace, with what came back -- the last one without
+ * a port (or without a "created" line after it) is the service the launch stopped at.
+ */
+extern int bootstrap_look_up2(mach_port_t bootstrap_port, const char *service_name, mach_port_t *service_port,
+    pid_t target_pid, uint64_t flags);
+extern hakios_xpc_connection xpc_connection_create_mach_service(const char *name, void *target_queue, uint64_t flags);
+
+static int
+hakios_bootstrap_look_up2(mach_port_t bootstrap_port, const char *service_name, mach_port_t *service_port,
+    pid_t target_pid, uint64_t flags)
+{
+	int result;
+
+	say("hakios: lookup -> %s\n", service_name ? service_name : "(null)");
+	result = bootstrap_look_up2(bootstrap_port, service_name, service_port, target_pid, flags);
+	say("hakios: lookup <- %s %d\n", service_name ? service_name : "(null)", result);
+	return result;
+}
+
+static hakios_xpc_connection
+hakios_xpc_create_mach_service(const char *name, void *target_queue, uint64_t flags)
+{
+	say("hakios: connect -> %s\n", name ? name : "(null)");
+	return xpc_connection_create_mach_service(name, target_queue, flags);
+}
+
+/*
+ * The names of the frames of a stack, as the runtime says them, are looked up by dyld walking every
+ * image of the shared cache. Here the cache is four gigabytes on the phone's flash, read through
+ * the driver when a page is first touched, so one such lookup in run 28 kept SpringBoard's main
+ * thread in dyld for minutes at a time -- eighteen of twenty-five dumps of the launch found it
+ * there, in backtrace_symbols called to format %@ in a log message -- and the launch never reached
+ * its first frame. A stack in a log line is worth nothing next to the screen, so this one is not
+ * looked up: the frames are named "(no symbols)" and the caller is said once.
+ */
+extern char **backtrace_symbols(void *const *buffer, int size);
+extern void backtrace_symbols_fd(void *const *buffer, int size, int fd);
+
+static unsigned backtraces;
+
+static char **
+hakios_backtrace_symbols(void *const *buffer, int size)
+{
+	char **names;
+
+	if (size <= 0) {
+		return NULL;
+	}
+	if (backtraces++ < 3) {
+		Dl_info info;
+		void *caller = __builtin_return_address(0);
+
+		if (dladdr(caller, &info) != 0 && info.dli_fname != NULL) {
+			const char *slash = strrchr(info.dli_fname, '/');
+
+			say("hakios: a stack is asked for by %s+%#lx (not looked up)\n",
+			    slash != NULL ? slash + 1 : info.dli_fname,
+			    (unsigned long)((uintptr_t)caller - (uintptr_t)info.dli_fbase));
+		}
+	}
+	if ((names = malloc((size_t)size * sizeof(char *))) == NULL) {
+		return NULL;
+	}
+	for (int i = 0; i < size; i++) {
+		names[i] = strdup("(no symbols)");
+	}
+	return names;
+}
