+static bool
+sb_patch_prologue(void *target, void *replacement)
+{
+	uint32_t code[4];
+	uint64_t address = (uint64_t)replacement;
+	uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);
+	uintptr_t first, last;
+	kern_return_t kr;
+
+	if (target == NULL || replacement == NULL) {
+		return false;
+	}
+	first = (uintptr_t)target & ~(page - 1);
+	last = ((uintptr_t)target + sizeof(code) - 1) & ~(page - 1);
+	kr = vm_protect(mach_task_self(), (vm_address_t)first, (vm_size_t)(last - first + page), FALSE,
+	    VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
+	if (kr != KERN_SUCCESS) {
+		say("hakios: %p cannot be made writable (%d)\n", target, (int)kr);
+		return false;
+	}
+	code[0] = 0x58000050;                   /* ldr x16, #8 */
+	code[1] = 0xd61f0200;                   /* br x16 */
+	memcpy(&code[2], &address, sizeof(address));
+	memcpy(target, code, sizeof(code));
+	sys_icache_invalidate(target, sizeof(code));
+	(void)vm_protect(mach_task_self(), (vm_address_t)first, (vm_size_t)(last - first + page), FALSE,
+	    VM_PROT_READ | VM_PROT_EXECUTE);
+	return true;
